{
  "compilerOptions": {
    "target": "ES2020", "lib": ["dom","dom.iterable","esnext"], "allowJs": true,
    "skipLibCheck": true, "strict": false, "noEmit": true, "esModuleInterop": true,
    "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true,
    "isolatedModules": true, "jsx": "preserve", "incremental": true,
    "baseUrl": ".", "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["../apps/v4/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "../apps/v4/registry/new-york-v4/**/*.ts", "../apps/v4/registry/new-york-v4/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
